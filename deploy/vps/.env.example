# Copy using ./init-env.py. Generated server secrets never need to be pasted here.
APP_ORIGIN=http://localhost:3107
API_ORIGIN=http://localhost:3107/backend
# Optional full HTTPS /upload endpoint behind a dedicated large-body gateway.
UPLOAD_PUBLIC_URL=
APP_DOMAIN=localhost
ACME_EMAIL=
HTTP_BIND=0.0.0.0
HTTP_PORT=3107
VPS_HTTPS=false
# Existing ingress terminates TLS; requires HTTPS origins and a private HTTP_BIND.
VPS_EXTERNAL_HTTPS=false
RELEASE_TAG=local

# init-env.py generates URL-safe values. Preserve them with encrypted backups.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BACKEND_AUTH_SECRET=
APP_SETTINGS_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
INITIAL_SETUP_TOKEN=
SELF_HOST_SINGLE_USER=true

BACKEND_CPU_ONLY=true
BACKEND_PLATFORM=linux/amd64
DISABLE_SIGN_UP=false
TRANSCRIPTION_PROVIDER=assemblyai
TRANSCRIPTION_LANGUAGE=
WHISPER_MODEL_SIZE=base
ASSEMBLY_AI_API_KEY=
LLM=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
PEXELS_API_KEY=
DEFAULT_PROCESSING_MODE=balanced
VIDEO_JOB_USER_CONCURRENCY=1
MEDIA_UPLOAD_DAILY_LIMIT=500
MAX_VIDEO_UPLOAD_BYTES=4000000000
QUEUED_TASK_TIMEOUT_SECONDS=1800

# Available in the dashboard; actual publishing remains off without channel destinations.
SOCIAL_PUBLISHING_ACCESS=all
NEXT_PUBLIC_SOCIAL_PUBLISHING=true
SOCIAL_PUBLISHING_PROVIDERS=youtube,instagram,tiktok
SOCIAL_PUBLISHING_ALLOWED_EMAILS=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_DATA_API_KEY=
YOUTUBE_PROXY_URL=
YOUTUBE_PROXY_COUNTRY=
YOUTUBE_POT_PROVIDER_URL=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
WORKFLOWS_ACCESS=all

# Optional archive target, e.g. archive:bucket/supoclip-originals.
# Configure credentials privately in rclone.conf. Use an encrypted rclone remote
# or bucket encryption when the original recordings contain sensitive material.
RECORDING_MIN_FREE_GB=5
RECORDING_MAX_CHANNELS=4
RECORDING_MAX_BACKLOG=24
RECORDING_ARCHIVE_REMOTE=

# Optional SES mail delivery for verification/password resets.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=onboarding@example.com
