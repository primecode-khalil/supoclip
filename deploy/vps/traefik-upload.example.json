{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "cert-manager.io/v1",
      "kind": "Certificate",
      "metadata": {"name": "supoclip-uploads", "namespace": "supoclip-vps"},
      "spec": {
        "secretName": "supoclip-uploads-tls",
        "issuerRef": {"name": "letsencrypt", "kind": "ClusterIssuer"},
        "dnsNames": ["uploads.clips.example.com"]
      }
    },
    {
      "apiVersion": "traefik.io/v1alpha1",
      "kind": "TLSOption",
      "metadata": {"name": "supoclip-uploads-http1", "namespace": "supoclip-vps"},
      "spec": {"minVersion": "VersionTLS12", "alpnProtocols": ["http/1.1"]}
    },
    {
      "apiVersion": "traefik.io/v1alpha1",
      "kind": "IngressRouteTCP",
      "metadata": {"name": "supoclip-uploads", "namespace": "supoclip-vps"},
      "spec": {
        "entryPoints": ["websecure"],
        "routes": [{
          "match": "HostSNI(`uploads.clips.example.com`)",
          "services": [{"name": "supoclip-gateway", "port": 80}]
        }],
        "tls": {
          "secretName": "supoclip-uploads-tls",
          "options": {"name": "supoclip-uploads-http1", "namespace": "supoclip-vps"}
        }
      }
    }
  ]
}
